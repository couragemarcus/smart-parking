INSTITUTION_NAME=Ho Technical University
PARKING_LAT=6.5885794
PARKING_LON=0.4660595
# ─── Backend ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./parking.db
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
VISITOR_SESSION_EXPIRE_MINUTES=120
RESERVATION_TIMEOUT_MINUTES=5

# ─── Institution ─────────────────────────────────────────────────────────────
INSTITUTION_NAME=Smart Campus University
PARKING_LAT=51.5074
PARKING_LON=-0.1278
NUM_SPACES=6

# ─── Sensor ──────────────────────────────────────────────────────────────────
HARDWARE_MODE=false
DETECTION_THRESHOLD_CM=50.0

# ─── Device Auth (IoT sensor → backend) ─────────────────────────────────────
DEVICE_ID=rpi-sensor-01
DEVICE_SECRET=change-device-secret

# ─── CORS (comma-separated allowed origins) ──────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Raspberry Pi sensor service (only needed on Pi) ────────────────────────
GPIO_TRIGGER_PIN=18
GPIO_ECHO_PIN=24
BACKEND_URL=http://localhost:8000
POLL_INTERVAL_S=0.1
COOLDOWN_S=5.0
HYSTERESIS_COUNT=3

# ─── Production PostgreSQL (docker-compose.prod.yml) ────────────────────────
# POSTGRES_PASSWORD=change-this-strong-password
# DOMAIN=parking.example.com
